# SM Service 环境变量示例
SM_ENV=development
SM_LOG_LEVEL=INFO
SM_LOG_FORMAT=console
SM_ALLOWED_HOSTS=localhost,127.0.0.1
SM_MAX_REQUEST_BYTES=1048576
SM_RATE_WINDOW_SECONDS=60
SM_RATE_MAX_REQUESTS=600
SM_INTERNAL_API_KEY=your-internal-api-key
SM_JWT_SECRET=your-jwt-secret-at-least-32-chars
SM_SM4_KEY_HEX=your-32-hex-chars-sm4-key
SM_DATABASE_URL=sqlite+aiosqlite:///./data.db
# SM_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/sm_service
SM_DB_POOL_SIZE=10
SM_DB_MAX_OVERFLOW=20
SM_AUDIT_CENTER_URL=http://localhost:8301
