# 仅用于 Docker Compose 或本地运行。不要提交真实 Token。
CORS_ORIGINS=http://localhost:8000
APP_PORT=8010
GITHUB_TOKEN=
SEED_DEMO_DATA=true

# 认证模式：local 供开发演示；erp 用于企业 ERP REST 登录。
AUTH_MODE=local
# AUTH_MODE=erp 时配置以下项目。ERP 返回默认字段：id、name、department、role。
ERP_AUTH_URL=
ERP_API_KEY=
ERP_VERIFY_TLS=true
ERP_USER_ID_FIELD=id
ERP_NAME_FIELD=name
ERP_DEPARTMENT_FIELD=department
ERP_ROLE_FIELD=role
ERP_DEFAULT_ROLE=employee
