# 仅用于 Docker Compose 或本地运行。不要提交真实 Token。
CORS_ORIGINS=http://localhost:8000
APP_PORT=8010
GITHUB_TOKEN=
SEED_DEMO_DATA=true

# ERP 集成认证：只允许服务端调用 ERP 的受保护集成端点。
ERP_AUTH_URL=https://ERP_HOST/api/integrations/knowledge-bot/auth
ERP_INTEGRATION_KEY=REPLACE_WITH_SHARED_RANDOM_INTEGRATION_KEY
ERP_VERIFY_TLS=true
KB_ENV=production
KB_SESSION_TTL_SECONDS=28800
KB_LOGIN_RATE_WINDOW_SECONDS=60
KB_LOGIN_RATE_MAX_REQUESTS=20
