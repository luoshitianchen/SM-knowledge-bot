# 仅内网反向代理样例：将此文件部署到受管 Nginx，并将证书目录权限设为仅管理员可读。
# 本示例绑定回环地址；企业 VPN / 零信任网关应在此之前完成身份与网络访问控制。
server {
    listen 127.0.0.1:8443 ssl http2;
    server_name kb.internal.example;

    ssl_certificate     /etc/nginx/certs/kb-server.crt;
    ssl_certificate_key /etc/nginx/certs/kb-server.key;
    ssl_client_certificate /etc/nginx/certs/enterprise-ca.crt;
    ssl_verify_client on;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    client_max_body_size 1m;
    client_body_timeout 15s;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;

    location / {
        proxy_pass http://127.0.0.1:8010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-Id $request_id;
        proxy_hide_header Server;
    }
}
